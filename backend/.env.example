GENETICS_API_BASE=https://integration.andrsn.in
GENETICS_API_USERNAME=GENETICS_USER
GENETICS_API_PASSWORD=
GENETICS_TOKEN_PATH=/auth/login
GENETICS_LOGIN_PATH=/genetics/login
GENETICS_VERIFY_PATH=/genetics/verify_otp
GENETICS_API_TIMEOUT=15

OTP_TTL_SECONDS=300

AUTH_SECRET=
AUTH_IDLE_HOURS=5
AUTH_COOKIE_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anderson
MYSQL_PASSWORD=
MYSQL_DATABASE=anderson_trackings

REPORTS_API_BASE=
REPORTS_API_KEY=
REPORTS_API_TIMEOUT=15

# Coverage Checker (anderson-coverage) — a separate repo, mounted in-process at
# /anderson-coverage. Only set this if it does not sit beside this repo.
COVERAGE_APP_DIR=
