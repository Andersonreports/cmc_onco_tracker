# ── Anderson Trackings — backend configuration ───────────────────────────
# Copy this file to ".env" (in the backend/ folder) and fill in real values.
# The GENETICS_API_* service credentials below are REQUIRED — the app calls
# IT's live auth/OTP API and will not sign anyone in without them.

# ── Authentication + OTP (IT's API — integration.andrsn.in) ──────────────
# IT owns the accounts and the WHOLE OTP flow. The app authenticates itself
# with a SERVICE account to get a Bearer token, then relays the user's
# mobile+password login and OTP verification (see it_auth.py). It never stores
# or sees user passwords / OTP codes beyond relaying them once.
#
# REQUIRED — the service (machine) account. Without GENETICS_API_PASSWORD every
# login is rejected with "sign-in service not configured". These names match the
# Report-Automation project, so you can reuse the exact same credentials block.
GENETICS_API_BASE=https://integration.andrsn.in
GENETICS_API_USERNAME=GENETICS_USER
GENETICS_API_PASSWORD=
# Endpoint paths (defaults match the current API; override only if IT changes them).
GENETICS_TOKEN_PATH=/auth/login
GENETICS_LOGIN_PATH=/genetics/login
GENETICS_VERIFY_PATH=/genetics/verify_otp
GENETICS_API_TIMEOUT=15

# How long a login attempt / OTP challenge stays valid (default 300 = 5 min).
OTP_TTL_SECONDS=300

# ── Sessions ─────────────────────────────────────────────────────────────
# Signing secret for session cookies. If unset, a random one is generated and
# saved to backend/.auth_secret. Set a fixed value to share across servers.
AUTH_SECRET=
# Hours a login stays valid (default 8)
AUTH_SESSION_HOURS=8
# Set to true ONLY when served over real HTTPS (cookies become Secure).
AUTH_COOKIE_SECURE=false

# ── Role mapping store: MySQL (local) ────────────────────────────────────
# The role mapping (mobile → role) is the only account data this app owns.
# Set these to store it in a local MySQL database. Leave them blank to use
# backend/roles.json instead (zero setup). If MySQL is set but unreachable,
# the app automatically falls back to roles.json. First run auto-creates the
# "user_roles" table and seeds the initial mappings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anderson
MYSQL_PASSWORD=
MYSQL_DATABASE=anderson_trackings
