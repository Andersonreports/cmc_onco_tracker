GENETICS_API_BASE=https://integration.andrsn.in
GENETICS_API_USERNAME=GENETICS_USER
GENETICS_API_PASSWORD=
GENETICS_TOKEN_PATH=/auth/login
GENETICS_LOGIN_PATH=/genetics/login
GENETICS_VERIFY_PATH=/genetics/verify_otp
GENETICS_API_TIMEOUT=15

OTP_TTL_SECONDS=300

AUTH_SECRET=
AUTH_IDLE_HOURS=5
AUTH_COOKIE_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anderson
MYSQL_PASSWORD=
MYSQL_DATABASE=anderson_trackings

REPORTS_API_BASE=
REPORTS_API_KEY=
REPORTS_API_TIMEOUT=15
REPORTS_PATH_QUERY=/genetics/get_sample_data_by_params
REPORTS_PATH_LIST=/genetics/get_sample_data_by_params
REPORTS_PATH_INSERT=/genetics/insert_data
REPORTS_PATH_UPDATE=/genetics/update_data
REPORTS_PATH_BULK=/genetics/insert_bulk_data

REPORTS_OVERLAY_PATH=

COVERAGE_APP_DIR=

# --- CMC Sample Tracking ---
# Data, mail, and release-date edits all go through this Apps Script Web
# App's exec URL.
CMC_ST_APPS_SCRIPT_EXEC_URL=

# Daily TAT-deadline alert email
CMC_ST_ALERT_RECIPIENTS=
CMC_ST_DASHBOARD_URL=https://your-domain/cmc-sample-tracking/

# Auto-fills "Report released date" from the exome tracker (matched by
# Anderson ID) instead of the team entering it twice.
CMC_ST_ENABLE_EXOME_SYNC=true

# Everything else (cache duration, cron schedule/timezone, or switching to
# a direct Sheets API + SMTP setup instead of the exec URL above) has a
# working default — see the CMC_ST_* constants at the top of
# backend/cmc_sample_tracking.py only if you need to change one.
