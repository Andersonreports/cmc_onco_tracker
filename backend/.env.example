# Copy this file to backend/.env and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# Generated by `python create_credentials.py` (sets the two lines below).
TRACKER_USER=
TRACKER_PASS_HASH=

# Random 64-char hex secret used to sign session JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
TRACKER_SECRET=

# Optional overrides (defaults shown):
# TRACKER_SESSION_HOURS=8
# TRACKER_GSHEET_ID=1rWGkrrKMMD6NnRvj6ZIfUxNE-VA9aUQYRmseSnnspDs
# TRACKER_GSHEET_GID=1767152443

# Set to "false" ONLY for local http:// testing. Must stay "true" (default)
# on any real deployment served over HTTPS, or the session cookie won't be
# marked Secure.
# TRACKER_COOKIE_SECURE=true
