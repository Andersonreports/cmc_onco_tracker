GENETICS_API_BASE=https://integration.andrsn.in
GENETICS_API_USERNAME=GENETICS_USER
GENETICS_API_PASSWORD=
GENETICS_TOKEN_PATH=/auth/login
GENETICS_LOGIN_PATH=/genetics/login
GENETICS_VERIFY_PATH=/genetics/verify_otp
GENETICS_API_TIMEOUT=15

OTP_TTL_SECONDS=300

AUTH_SECRET=
AUTH_IDLE_HOURS=5
AUTH_COOKIE_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anderson
MYSQL_PASSWORD=
MYSQL_DATABASE=anderson_trackings

# Exome Tracker samples — IT's integration API, not a local table.
# Blank REPORTS_API_BASE reuses GENETICS_API_BASE; blank REPORTS_API_KEY reuses
# the GENETICS_USER service token (IT's tokens expire in ~15 min, so a pasted
# static key will stop working).
REPORTS_API_BASE=
REPORTS_API_KEY=
REPORTS_API_TIMEOUT=15
# /genetics/get_sample_data is in IT's collection but is NOT deployed (404);
# the params endpoint with an empty filter returns everything.
REPORTS_PATH_QUERY=/genetics/get_sample_data_by_params
REPORTS_PATH_LIST=/genetics/get_sample_data_by_params
REPORTS_PATH_INSERT=/genetics/insert_data
REPORTS_PATH_UPDATE=/genetics/update_data
REPORTS_PATH_BULK=/genetics/insert_bulk_data
# Clinical reviewer — the one tracker field IT's schema has no column for,
# kept locally and keyed by IT's record id.
# Blank = backend/tracker_local_fields.json.
REPORTS_OVERLAY_PATH=

COVERAGE_APP_DIR=
