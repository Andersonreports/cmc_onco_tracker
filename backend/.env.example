GENETICS_API_BASE=https://integration.andrsn.in
GENETICS_API_USERNAME=GENETICS_USER
GENETICS_API_PASSWORD=
GENETICS_TOKEN_PATH=/auth/login
GENETICS_LOGIN_PATH=/genetics/login
GENETICS_VERIFY_PATH=/genetics/verify_otp
GENETICS_API_TIMEOUT=15

OTP_TTL_SECONDS=300

AUTH_SECRET=
AUTH_IDLE_HOURS=5
AUTH_COOKIE_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anderson
MYSQL_PASSWORD=
MYSQL_DATABASE=anderson_trackings

REPORTS_API_BASE=
REPORTS_API_KEY=
REPORTS_API_TIMEOUT=15
REPORTS_PATH_QUERY=/genetics/get_sample_data_by_params
REPORTS_PATH_LIST=/genetics/get_sample_data_by_params
REPORTS_PATH_INSERT=/genetics/insert_data
REPORTS_PATH_UPDATE=/genetics/update_data
REPORTS_PATH_BULK=/genetics/insert_bulk_data

REPORTS_OVERLAY_PATH=

COVERAGE_APP_DIR=

# --- CMC Sample Tracking ---
# Simplest option: reuse an already-deployed Apps Script Web App exec URL. If
# set, this is used instead of the Sheets API / SMTP settings below.
CMC_ST_APPS_SCRIPT_EXEC_URL=

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# (only used when CMC_ST_APPS_SCRIPT_EXEC_URL is not set)
CMC_ST_SPREADSHEET_ID=
# Path to a Google service-account JSON key file with view access to the
# sheet (share the spreadsheet with the service account's client_email as
# Viewer), or paste the whole JSON as one line via CMC_ST_GOOGLE_SERVICE_ACCOUNT_JSON.
CMC_ST_GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
CMC_ST_GOOGLE_SERVICE_ACCOUNT_JSON=

CMC_ST_SMTP_HOST=smtp.gmail.com
CMC_ST_SMTP_PORT=587
CMC_ST_SMTP_SECURE=false
CMC_ST_SMTP_USER=
CMC_ST_SMTP_PASS=
CMC_ST_MAIL_FROM=

# Daily TAT-deadline alert emails
CMC_ST_ALERT_RECIPIENTS=
CMC_ST_DASHBOARD_URL=https://your-domain/cmc-sample-tracking/
CMC_ST_TAT_ALERT_CRON=0 9 * * *
CMC_ST_TZ=Asia/Kolkata
CMC_ST_ENABLE_TAT_ALERTS=true
