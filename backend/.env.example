GENETICS_API_BASE=https://integration.andrsn.in
GENETICS_API_USERNAME=GENETICS_USER
GENETICS_API_PASSWORD=
GENETICS_TOKEN_PATH=/auth/login
GENETICS_LOGIN_PATH=/genetics/login
GENETICS_VERIFY_PATH=/genetics/verify_otp
GENETICS_API_TIMEOUT=15

OTP_TTL_SECONDS=300

AUTH_SECRET=
AUTH_IDLE_HOURS=5
AUTH_COOKIE_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anderson
MYSQL_PASSWORD=
MYSQL_DATABASE=anderson_trackings

REPORTS_API_BASE=
REPORTS_API_KEY=
REPORTS_API_TIMEOUT=15

# Coverage Checker — mounted in-process at /anderson-coverage. It ships in this
# repo under anderson-coverage/; only set this to run it from another path.
COVERAGE_APP_DIR=
